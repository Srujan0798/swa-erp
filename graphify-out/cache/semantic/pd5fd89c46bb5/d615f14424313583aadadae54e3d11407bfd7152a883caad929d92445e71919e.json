{"nodes": [{"id": "work_wave_48_03_token_security_hygiene", "label": "Wave-48 Token Security Hygiene", "file_type": "document", "source_file": "work/wave-48/03-token-security-hygiene.md", "source_location": null}, {"id": "content_security_policy", "label": "Content Security Policy", "file_type": "concept", "source_file": "work/wave-48/03-token-security-hygiene.md", "source_location": null}, {"id": "refresh_token_rotation", "label": "Refresh Token Rotation", "file_type": "concept", "source_file": "work/wave-48/03-token-security-hygiene.md", "source_location": null}, {"id": "csp_gap", "label": "Content Security Policy Gap", "file_type": "rationale", "source_file": "work/wave-48/03-token-security-hygiene.md", "source_location": null, "rationale": "No Content-Security-Policy header anywhere. Access + refresh tokens stored in localStorage - without CSP, any XSS becomes full token theft with no mitigation."}, {"id": "refresh_token_rotation_gap", "label": "Refresh Token Rotation Gap", "file_type": "rationale", "source_file": "work/wave-48/03-token-security-hygiene.md", "source_location": null, "rationale": "Refresh tokens never rotate. refresh_access_token() issues new access token but reuses SAME refresh token indefinitely. Combined with CSP gap, single XSS yields refresh token valid for full JWT_REFRESH_TTL_DAYS with no rotation to limit blast radius."}, {"id": "src_backend_services_auth_service_py", "label": "Auth Service", "file_type": "code", "source_file": "work/wave-48/03-token-security-hygiene.md", "source_location": null}, {"id": "src_backend_db_repositories_refresh_token_repo_py", "label": "Refresh Token Repository", "file_type": "code", "source_file": "work/wave-48/03-token-security-hygiene.md", "source_location": null}], "edges": [{"source": "work_wave_48_03_token_security_hygiene", "target": "content_security_policy", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "work/wave-48/03-token-security-hygiene.md", "sourc