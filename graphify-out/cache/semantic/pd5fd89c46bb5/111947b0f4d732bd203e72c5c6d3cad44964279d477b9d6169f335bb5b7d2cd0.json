{"nodes": [{"id": "docs_decisions_0002_core_id_chain_gap", "label": "ADR-0002 Core ID Chain Gap", "file_type": "document", "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_reference_id_format", "label": "SWA Reference ID Format", "file_type": "concept", "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every entity uses SWA-{year}-{3-letter-code}-{seq:03d} format (e.g., SWA-2025-INQ-001, SWA-2025-SA-011). Counters reset every calendar year. This matches the live Excel sheets and was confirmed by Viraj."}, {"id": "concept_client_names", "label": "Client Names APEX INNER INSUDESIGN", "file_type": "concept", "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "APEX and INNER are client names, not agreement types. INSUDESIGN is the service name (product), not a client. This was a key correction from early misreading where these were treated as agreement types."}, {"id": "concept_yearly_id_reset", "label": "Yearly ID Sequence Reset", "file_type": "concept", "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reference counters reset every calendar year (e.g., SWA-2025-SA-011 in 2025 becomes SWA-2026-SA-001 in 2026). Confirmed by Viraj. Implemented via reference_counters table keyed by (entity_type, year)."}, {"id": "concept_no_leads_module", "label": "No Leads Module Decision", "file_type": "concept", "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per Viraj's instruction, there is no Leads sheet. Lead ID / LDI columns removed entirely - not stored even historically. New work is Inquiry only (SWA-{year}-INQ-...). Migration 0030 drops residual DB column."}], "edges": [{"source": "docs_decisions_0002_core_id_chain_gap", "target": "docs_real_data", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "weight": 1.0}, {"source": "concept_core_business_chain", "target": "concept_client_names", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "weight": 1.0}, {"source": "concept_core_business_chain", "target": "concept_yearly_id_reset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "weight": 1.0}, {"source": "concept_core_business_chain", "target": "concept_no_leads_module", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "weight": 1.0}, {"source": "concept_reference_id_format", "target": "concept_yearly_id_reset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "weight": 1.0}, {"source": "concept_viraj", "target": "concept_client_names", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0002-core-id-chain-gap.md", "source_location": null, "weight": 1.0}, {"source": "concept_viraj", "target": "concept_yearly_id_reset", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0002-core-id-chain-gap.md