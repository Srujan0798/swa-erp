{"nodes": [{"id": "specify_memory_constitution", "label": "SWA ERP Constitution", "file_type": "document", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "wave_based_shipping", "label": "Wave-Based Shipping", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wave-based shipping: Each wave is end-to-end demoable before the next begins. Acceptance criteria are executable - every task has runnable tests in contracts/."}, {"id": "money_decimal", "label": "Money as Decimal(18,2)", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Money is Decimal(18,2). Never float. INR is the default currency; multi-currency ready."}, {"id": "soft_delete_pattern", "label": "Soft-Delete Pattern", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No hard deletes for business data. Use deleted_at soft-delete. Workers and audit logs are exempt."}, {"id": "audit_log_principle", "label": "Audit Log Principle", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audit log is append-only. Every mutation gets an audit_log entry: who, when, what before, what after."}, {"id": "optimistic_locking", "label": "Optimistic Locking via Version Column", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimistic locking via version column. Updates require If-Match on critical entities."}, {"id": "secrets_env_only", "label": "Secrets via Environment Only", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secrets via env only. Never in code, never in repo. .env is gitignored."}, {"id": "jwt_short_lived", "label": "Short-Lived JWT Tokens", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JWT short-lived (1h access, 30d refresh). Rotate refresh tokens."}, {"id": "rbac_server_side", "label": "Server-Side RBAC Enforcement", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RBAC enforced server-side. Frontend hides UI but server is the source of truth."}, {"id": "parameterized_queries", "label": "Parameterized SQL Queries Only", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL via parameterized queries only. No string concatenation, no f-strings into SQL."}, {"id": "archive_principle", "label": "Archive Instead of Delete", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never delete; archive. attic/, docs/historical/, prompts/archive/."}, {"id": "adr_principle", "label": "ADR for Major Decisions", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADRs for every major decision. docs/decisions/0NNN-title.md. No oral history."}, {"id": "compliance_versioned", "label": "Versioned Compliance Standards", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compliance standards are versioned. NBC 2016, NBC 2024 \u2014 code never assumes 'latest'. Standards are data, not code."}, {"id": "boq_schema_first", "label": "Schema-First BOQ Ingestion", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BOQ ingestion is schema-first. Validate before any DB write. Reject with clear errors. No partial inserts."}, {"id": "no_rfq2boq_coupling", "label": "No Coupling to rfq2boq", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No coupling to rfq2boq (Project 1). ERP accepts BOQ files of any source. Zero direct API calls between the two products."}, {"id": "test_coverage_75", "label": "75% Test Coverage Requirement", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test coverage \u2265 75% on services. Routers and models lower; services and parsers must hit 75%+."}, {"id": "performance_budgets", "label": "Performance Budgets", "file_type": "rationale", "source_file": ".specify/memory/constitution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performance budgets. API <500ms P95, page load <1.5s P95, BOQ parse <30s for 100 lines."}], "edges": [{"source": "speci