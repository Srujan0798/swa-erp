# SWA ERP — PRODUCTION environment template.
#
# Copy to `.env.production` and fill in every value before deployment day.
# Mirrors the dev .env.example variable names exactly (so no app-code rename is
# needed). Every uncertain value carries a PENDING IT ANSWER comment pointing at
# the specific question in docs/IT_BRIEF.md.

# ---- App ----
APP_NAME=swa-erp
APP_ENV=production
DEBUG=false

# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED - the app will refuse to start without this once wave-18's
# SECRET_KEY validation lands. Do NOT leave the placeholder in production.
SECRET_KEY=

# ---- Database (used by docker-compose.prod.yml) ----
POSTGRES_USER=swa
# PENDING IT ANSWER (Q7): confirm postgres in-compose vs native Windows service.
POSTGRES_PASSWORD=
POSTGRES_DB=swa_erp

# App connection strings.
DATABASE_URL=postgresql://swa:${POSTGRES_PASSWORD}@postgres:5432/swa_erp
REDIS_URL=redis://redis:6379/0

# PENDING IT ANSWER (Q6): the real internal hostname staff will use, e.g.
# ["https://erp.swa.local"]. Comma- or JSON-list format matching dev example.
CORS_ORIGINS=["http://localhost:3000"]

# ---- Auth ----
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

# ---- TLS (PENDING IT ANSWER Q4) ----
# No app-level TLS var is needed — termination is at nginx/frontend (see
# docker-compose.prod.yml Q4 note). If you later terminate TLS at a reverse
# proxy instead, no change here is required.

# ---- Optional: external services (later waves) ----
SENTRY_DSN=
RESEND_API_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ---- Optional: orchestrator MCP servers ----
TAVILY_API_KEY=
